# ============================================
# REQUIRED: Core Configuration
# ============================================

# Discord Bot Credentials (Required)
# Get from: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# ============================================
# REQUIRED: Database Configuration
# ============================================

# PostgreSQL Settings
POSTGRES_DB=discord_bot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_to_secure_password

# ============================================
# REQUIRED: Service URLs (Docker Compose)
# ============================================
# These URLs use Docker service names.
# For local development, override with localhost URLs.

DATABASE_URL=postgres://postgres:change_this_to_secure_password@postgres:5432/discord_bot

# For local development (uncomment and modify):
# DATABASE_URL=postgres://postgres:password@localhost:5432/discord_bot

# ============================================
# OPTIONAL: Music Streaming Platform APIs
# ============================================
# These are OPTIONAL. The bot will work without them:
# - YouTube: Works without API key (uses scraping)
# - Spotify: Converts Spotify links to YouTube automatically
# - SoundCloud: Works without API key
#
# However, having API keys may improve reliability and reduce rate limits.

# Optional: Spotify API (improves Spotify link handling)
# Get from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: YouTube API (for better search results, higher rate limits)
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Optional: YouTube signature deciphering server used by Lavalink's YouTube plugin.
# Leave empty to use the public instance https://cipher.kikkia.dev/ (no password,
# 10 req/s, no uptime guarantee). To self-host https://github.com/kikkia/yt-cipher
# (run it with OVERRIDE_SCRIPT_VARIANT=IAS), set its URL and password here.
# (Cookies are not supported by Lavalink's YouTube plugin, so YOUTUBE_COOKIE was removed.)
YOUTUBE_CIPHER_URL=
YOUTUBE_CIPHER_PASSWORD=

# ============================================
# OPTIONAL: Lavalink Audio Server
# ============================================
# Lavalink handles YouTube/Spotify/SoundCloud audio extraction
# Much more reliable than in-process extraction

LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass

# ============================================
# OPTIONAL: Redis Cache (Currently Disabled)
# ============================================
# Redis is currently disabled to save resources (64MB memory).
# Uncomment these settings and enable Redis in docker-compose.yml if needed.
#
# REDIS_PASSWORD=change_this_to_secure_password
# REDIS_URL=redis://:change_this_to_secure_password@redis:6379
#
# For local development:
# REDIS_URL=redis://:password@localhost:6379

# ============================================
# OPTIONAL: Performance & Resource Settings
# ============================================

# Music Queue Limits
MUSIC_MAX_QUEUE_SIZE=100
MUSIC_MAX_DURATION=3600

# ============================================
# OPTIONAL: Environment Settings
# ============================================

# Node Environment (production/development)
NODE_ENV=production

# Logging Level (error/warn/info/debug)
LOG_LEVEL=info
